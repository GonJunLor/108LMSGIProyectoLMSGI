<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="pedido">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="tractor" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="componente" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:sequence> 
                                <xs:element name="fechaEntrega" minOccurs="0">
                                <!--Elemento fechaEntrega con restricciones de tipo y formato  -->
                                    <xs:complexType>
                                        <xs:attribute name="mes" use="required"/>
                                        <xs:attribute name="anio" use="required"/>
                                        <xs:attribute name="dia" use="optional"/>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="fragil" type="xs:string" minOccurs="0"/> 
                                <xs:element name="peso">
                                    <xs:complexType>
                                        <xs:simpleContent>
                                            <xs:extension base="xs:positiveInteger">
                                                <xs:attribute name="unidad">
                                                    <xs:simpleType>
                                                        <xs:restriction base="xs:string">
                                                            <xs:pattern value="kg|g"/>
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                            </xs:extension>
                                        </xs:simpleContent>
                                    </xs:complexType>
                                </xs:element>
                                <xs:element name="numeroSerie" type="xs:string"/>
                                <xs:element name="kmMaximos"  type="xs:positiveInteger" minOccurs="0"/>
                                <xs:element name="cantidad" type="xs:positiveInteger" default="1"/>
                            </xs:sequence> <!-- end of componente sequence -->
                            <xs:attribute name="referencia" >
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="[A-Z0-9]{10}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence> <!-- end of tractor sequence -->
                <xs:attribute name="codigoFabricante" use="required">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[fF][0-9]{3}"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
            </xs:complexType>
        </xs:element>
    </xs:sequence> <!-- end of pedido sequence-->
    <xs:attribute name="idPedido" use="required">
        <xs:simpleType>
            <xs:restriction base="xs:string">
                <xs:pattern value="[pP][0-9]{3}"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fecha" type="xs:date" use="required" />
</xs:complexType>
</xs:element>
</xs:schema>